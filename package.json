{
  "name": "mhdb-gen",
  "version": "0.0.0",
  "description": "Generator for the mhdb (historical events) static-site encyclopedia.",
  "private": true,
  "type": "module",
  "bin": {
    "mhdb-gen": "./dist/bin/mhdb-gen.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.prod.json && cp -R src/templates dist/templates",
    "lint": "eslint src test",
    "pretest": "rm -rf build",
    "test": "tsc && cp -R src/templates build/src/templates && node --test 'build/test/**/*.test.js'",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "marked": "^18.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3"
  }
}
