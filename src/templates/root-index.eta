<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MHDB</title>
    <base href="./">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a class="brand-mark" href="index.html" aria-label="MHDB home">MHDB</a>
      </div>
    </header>
    <div class="breadcrumbs-bar">
      <div class="breadcrumbs-inner">
        <div class="breadcrumbs-main">
          <nav aria-label="breadcrumb">
            <span class="current">Home</span>
          </nav>
        </div>
        <div class="breadcrumbs-meta"></div>
      </div>
    </div>
    <main>
      <h1>MHDB</h1>
<% if (it.length === 0) { %>
      <p>No events with seasonal placement yet.</p>
<% } else { %>
      <table class="decade-index">
        <caption>Historical events by year</caption>
        <thead>
          <tr>
            <th></th>
<% for (let columnIndex = 0; columnIndex < 10; columnIndex++) { %>
            <th><%= columnIndex %></th>
<% } %>
          </tr>
        </thead>
        <tbody>
<% for (const decadeRow of it) { %>
          <tr>
            <th scope="row"><%= decadeRow.decadeLabel %></th>
<% for (const yearLink of decadeRow.yearLinks) { %>
<% if (yearLink !== null) { %>
            <td><a href="<%= yearLink.indexPagePath %>"><%= yearLink.label %></a></td>
<% } else { %>
            <td><span class="decade-empty">·</span></td>
<% } %>
<% } %>
          </tr>
<% } %>
        </tbody>
      </table>
<% } %>
    </main>
  </body>
</html>
