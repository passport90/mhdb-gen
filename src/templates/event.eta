<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= it.title.plainText %> - MHDB</title>
    <base href="../../../">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a class="brand-mark" href="index.html" aria-label="MHDB home">MHDB</a>
      </div>
    </header>
    <div class="breadcrumbs-bar">
      <div class="breadcrumbs-inner">
        <div class="breadcrumbs-main">
          <nav aria-label="breadcrumb">
            <a href="index.html">Home</a>
            <a href="<%= it.breadcrumb.year.indexPagePath %>"><%= it.breadcrumb.year.label %></a>
            <a href="<%= it.breadcrumb.season.indexPagePath %>"><%= it.breadcrumb.season.label %></a>
            <span class="current"><%~ it.title.inlineHtml %></span>
          </nav>
        </div>
        <div class="breadcrumbs-meta"></div>
      </div>
    </div>
    <main>
<% if (it.illustrationPath !== null) { %>
      <figure class="event-illustration">
        <img src="<%= it.illustrationPath %>" alt="">
        <figcaption class="event-illustration-title">
          <h1 class="title-with-subtitle event-title"><%~ it.title.inlineHtml %></h1>
        </figcaption>
      </figure>
<% } %>
      <div class="detail-layout">
        <section class="detail-secondary" aria-label="Event details">
          <dl class="detail-meta">
            <div class="detail-meta-item">
              <dt>Season</dt>
              <dd><a href="<%= it.breadcrumb.season.indexPagePath %>"><%= it.breadcrumb.season.label %></a></dd>
            </div>
            <div class="detail-meta-item">
              <dt>Date</dt>
              <dd><%= it.dateRangeLabel %></dd>
            </div>
          </dl>
        </section>
        <div class="main-content">
<% if (it.illustrationPath === null) { %>
          <h1 class="title-with-subtitle event-title"><%~ it.title.inlineHtml %></h1>
<% } %>
          <div class="description"><%~ it.descriptionHtml %></div>
        </div>
      </div>
      <div class="paper-stamp">
<% if (it.generatedBy !== null) { %>
        <span class="stamp stamp-model"><%= it.generatedBy %></span>
<% } %>
        <span class="stamp stamp-updated">Updated <%= it.updatedAtLabel %> UTC</span>
      </div>
    </main>
  </body>
</html>
